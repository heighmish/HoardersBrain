{
  "name": "hoardersbrain",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "drizzle-orm": "0.45.4",
    "expo": "58.0.26",
    "expo-constants": "58.0.16",
    "expo-dev-client": "58.0.21",
    "expo-drizzle-studio-plugin": "0.2.1",
    "expo-font": "58.0.12",
    "expo-linking": "58.0.17",
    "expo-router": "58.0.32",
    "expo-splash-screen": "58.0.14",
    "expo-sqlite": "58.0.18",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "babel-plugin-inline-import": "3.0.0",
    "drizzle-kit": "0.31.11",
    "expo-mcp": "0.2.4",
    "husky": "9.1.7",
    "knip": "^6.48.0",
    "lint-staged": "17.6.1",
    "oxlint": "1.94.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "lint:design": "bash scripts/lint-design-tokens.sh",
    "lint:unused": "knip --include files",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "check": "npm run lint && npm run typecheck && npm run lint:design && npm run lint:unused",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "oxlint",
    "src/{app,components}/**/*.{ts,tsx}": "npm run lint:design"
  },
  "private": true,
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
